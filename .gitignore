# ---- 依赖 / 构建产物 ----
node_modules/
dist/
dist-ssr/
src-tauri/target/

# ---- 本地缓存 / 临时目录 ----
.build-tmp/
.tauri-cache/
.vite/
node_modules/.vite/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
*.log

# ---- 备份文件（改配置前自动生成，禁止入库）----
*.bak
*.bak-*
*.broken-*
*.synaroute.bak

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Claude 本地会话 / 记忆（不入公开仓库）----
.claude/

# ---- 敏感数据（双保险：这些本不在项目目录，仍显式忽略）----
*.env
.env.*
secrets.enc
*.pem
*.key
.tmp-release/
.codegraph/
.plans/

# ---- 运行时数据（正常在 %APPDATA%\SynaRoute\，但误拷进仓库就会随发布外泄）----
#
# `config.json` 里有全部 Key 的地址/映射/余额配置，`secrets.enc` 是密钥库（DPAPI 密文，
# 绑开发机账户）。任一进包 = 把开发者自己的付费 API Key 发给每个用户，且 secrets.enc
# 换机解不开、还会顶掉用户自己的密钥库。exe 同级 `logs/` 里有请求快照（开了日志开关时含对话）。
# 判据：发布前 `git ls-files` 不该列出这三者中任何一个，产物里也 grep 不到其**内容**
#（代码里的路径常量是运行时解析的，出现属正常）。
/config.json
/secrets.enc
/logs/
/synaroute.exe

# ---- 官网截图采集用的临时 Chrome 配置目录（脚本已改用系统临时目录，此处为双保险）----
.chrome-capture/

# ---- 官网排版人工核对用的截图，只在本地生成、不入库 ----
site/.shots-review/

# ---- 在线更新清单：每次发版按当次产物的签名重新生成，落在 GitHub Release 上 ----
# 不入库的理由：它必须与那一次构建出的 setup.exe 严格配对（签名是对二进制签的）。
# 若把它提交进仓库，就会出现「仓库里的 latest.json 指向旧签名、Release 上的是新的」
# 两份真相，而错的那份表现为用户更新时验签失败 —— v0.1.14 正是这么翻的车。
/latest.json
*.key
*.key.pub
