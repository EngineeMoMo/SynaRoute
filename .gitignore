# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Claude 本地会话 / 记忆（不入公开仓库）----
.claude/

# ---- 敏感数据（双保险：这些本不在项目目录，仍显式忽略）----
*.env
.env.*
secrets.enc
*.pem
*.key
.tmp-release/
.codegraph/
