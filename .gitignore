# ---- 依赖 / 构建产物 ----
node_modules/
dist/
dist-ssr/
src-tauri/target/

# ---- 本地缓存 / 临时目录 ----
.build-tmp/
.tauri-cache/
.vite/
node_modules/.vite/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
*.log

# ---- 备份文件（改配置前自动生成，禁止入库）----
*.bak
*.bak-*
*.broken-*
*.synaroute.bak

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Claude 本地会话 / 记忆（不入公开仓库）----
.claude/

# ---- 敏感数据（双保险：这些本不在项目目录，仍显式忽略）----
*.env
.env.*
secrets.enc
*.pem
*.key
.tmp-release/
.codegraph/
.plans/

# ---- 官网截图采集用的临时 Chrome 配置目录（脚本已改用系统临时目录，此处为双保险）----
.chrome-capture/

# ---- 官网排版人工核对用的截图，只在本地生成、不入库 ----
site/.shots-review/
