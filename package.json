{
  "name": "synaroute",
  "private": true,
  "version": "0.1.43",
  "type": "module",
  "description": "SynaRoute - 智能 API Key 路由代理与配置管理桌面软件",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-tailwind-tokens.mjs",
    "check:tailwind": "node scripts/check-tailwind-tokens.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "audit:release": "node scripts/audit-release-bundle.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ratchet": "node scripts/check-ratchet.mjs",
    "ratchet:update": "node scripts/check-ratchet.mjs --update",
    "ratchet:verify": "node scripts/verify-ratchet-update.mjs",
    "check:embedded": "node scripts/check-frontend-embedded.mjs",
    "smoke:installer": "node scripts/smoke-installer.mjs",
    "gates": "npm run check:forbidden && npm run check:site && npm run ratchet && npm run ratchet:verify",
    "check:site": "node site/scripts/check-forbidden.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
