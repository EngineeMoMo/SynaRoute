{
  "name": "synaroute-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SynaRoute 官网（独立于桌面应用的静态站点）",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && tsc && vite build && node scripts/check-opacity.mjs && node scripts/postbuild.mjs && node scripts/prerender.mjs && node scripts/check-forbidden.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-favicon.mjs && node scripts/gen-og.mjs",
    "check": "node scripts/check-i18n.mjs && node scripts/check-forbidden.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.4"
  },
  "browserslist": [
    "defaults",
    "safari >= 15",
    "ios_saf >= 15",
    "chrome >= 87",
    "firefox >= 78",
    "edge >= 88",
    "not dead",
    "not op_mini all"
  ]
}
