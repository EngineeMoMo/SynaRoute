<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Hardened Runtime entitlements（代码签名 + 公证必需）。
  Tauri 默认开启 hardenedRuntime: true。在 Hardened Runtime 下 JIT 被系统阻止，
  而 WKWebView 运行 JavaScript 依赖 JIT 与无符号可执行内存——缺少这两条权限，
  签名的 app 启动后网页空白或直接崩溃。
  参考：https://v2.tauri.app/distribute/sign/macos/
-->
<plist version="1.0">
<dict>
  <!-- WKWebView JavaScript JIT 编译 -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- WKWebView 内部需要可写可执行内存（与 JIT 配套） -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
