{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SynaRoute 默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "shell:allow-open",
    "dialog:default",
    "updater:default",
    "notification:default"
  ]
}
