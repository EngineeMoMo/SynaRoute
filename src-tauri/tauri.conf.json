{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynaRoute",
  "version": "0.1.38",
  "identifier": "com.synaroute.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SynaRoute",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "incognito": true,
        "additionalBrowserArgs": "--disable-http-cache"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "./installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNDZFQ0I4MDg3REUyNkYKUldSdjRuMEl1T3hHZXJBcWVVSzBoNm1pRkR6Z0dOcGxYUUt0TWxOUzdUQWNJMC9YdGFacm94eFQK",
      "endpoints": [
        "https://github.com/EngineeMoMo/SynaRoute/releases/latest/download/latest.json"
      ]
    }
  }
}
